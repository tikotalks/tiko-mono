{
  "name": "@tiko/identity",
  "version": "0.1.0",
  "description": "Cloudflare-native device-first identity package for Tiko apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts",
    "./repository": "./src/repository.ts",
    "./fingerprint": "./src/fingerprint.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "vitest": "^1.3.1"
  }
}
