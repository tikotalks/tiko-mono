{
  "name": "@tiko/smoke-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Vitest and Playwright smoke harness for Tiko apps",
  "type": "module",
  "scripts": {
    "smoke": "node scripts/smoke-apps.mjs",
    "smoke:build": "node scripts/smoke-apps.mjs --build-only",
    "smoke:e2e": "playwright test -c playwright.config.ts",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "typescript": "~5.3.3",
    "vitest": "^1.3.1"
  }
}
